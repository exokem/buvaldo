---
import BackgroundCover from "../../components/BackgroundCover.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectSection from "../../components/projects/ProjectSection.astro";
---

<PageLayout title='Editorial Work'>
    <BackgroundCover src="/cover/editorial.jpg" blur/>
    <div class="title">
        <h1 class="heading-title">Editorial Work</h1>
    </div>
    <ProjectSection type="editorial" section="hbo"/>
    <ProjectSection type="editorial" section="narrative"/>
    <ProjectSection type="editorial" section="commercial"/>
</PageLayout>
<style>
    div.title {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: row;
        justify-content: center;
        padding: 5rem 0;

        h1 {
            font-size: 4rem;
            line-height: 4rem;
        }
    }
</style>
