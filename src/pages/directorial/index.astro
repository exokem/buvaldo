---
import BackgroundCover from "../../components/BackgroundCover.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import ProjectSection from "../../components/projects/ProjectSection.astro";
---

<PageLayout title='Directorial Work'>
    <BackgroundCover src="/cover/directorial.jpg" blur/>
    <div class="title">
        <h1 class="heading-title">Directorial</h1>
    </div>
    <ProjectSection type="directorial" section="narrative"/>
    <ProjectSection type="directorial" section="student"/>
    <ProjectSection type="directorial" section="commercial"/>
</PageLayout>

<style is:global>
    main#directorial-work {
        section#narrative {
            div.projects {
                width: 100%;

                @media(min-width: 390px) {
                    width: auto;
                    display: flex;
                    justify-content: center;
                }

                @media(max-width: 1080px) {
                    flex-direction: column;
                }

                article {
                    @media(min-width: 550px) {
                        --width: 475px;
                    }
                }
            }

            div.empty-project {
                display: none;
            }
        }
    }
</style>

<style>
    div.title {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: row;
        justify-content: center;

        padding: 2rem 0;

        @media(min-width: 512px) {
            padding: 5rem 0;
        }
    }
</style>
