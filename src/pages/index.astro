---

import PageLayout from "../layouts/PageLayout.astro";
import BackgroundCover from "../components/BackgroundCover.astro";
import Icon from "../components/Icon.astro";
---

<PageLayout title='Bryan Uvaldo'>
    <BackgroundCover src="/cover.jpg"/>
    <div class="title">
        <section>
            <h1>Bryan Uvaldo</h1>
            <h2>
                Brazilian-American Filmmaker <br/> <span>& NYU Tisch Graduate</span>
            </h2>
            <div class="shortcuts">
                <a href="/directorial">
                    <Icon>movie</Icon>
                    Directing
                </a>
                <a href="/editorial">
                    <Icon>theaters</Icon>
                    Editing
                </a>
                <a href="/about">
                    <Icon>person</Icon>
                    About
                </a>
            </div>
        </section>
    </div>
</PageLayout>

<style lang="css">
    section {
        h1, h2, a {

            opacity: 1;
            transform: none;
            transition-property: opacity, transform;
            transition-duration: 450ms;
            @starting-style {
                opacity: 0;
                transform: translateY(2rem);
            }
        }

        h2 {
            transition-delay: 50ms;
        }

        a {
            &:first-child {
                transition-delay: 100ms;
            }
            &:nth-child(2) {
                transition-delay: 150ms;
            }
            &:last-child {
                transition-delay: 200ms;
            }
        }
    }
</style>

<style lang="scss">
    div.title {
        display: flex;
        flex-direction: column;
        justify-content: end;
        height: calc(100vh - var(--nav-height));
        filter: drop-shadow(0px 1px 3px #000000FF);

        background: linear-gradient(#00000000 45%, #0000007D);

        padding-bottom: 1rem;

        @media (min-width: 1024px) {
            padding-bottom: 5rem;
        }

        section {
            display: flex;
            margin: 0 auto;
            max-width: 1280px;
            flex-direction: column;
            gap: 1.5rem;
            padding: 0 1rem;
            @media (min-width: 1280px) {
                width: 1280px;
            }
        }

        h1 {
            text-transform: uppercase;
            font-family: "Permanent Marker", sans-serif;
            font-weight: 400;
            font-size: 4rem;
            line-height: 4rem;

            color: var(--accent);

            @media(min-width: 768px) {
                font-size: 6rem;
                line-height: 6rem;
            }

            @media(min-width: 1024px) {
                font-size: 8rem;
                line-height: 8rem;
            }
        }

        h2 {
            font-family: "Permanent Marker", sans-serif;
            font-size: 1.5rem;
            color: var(--accent);

            @media(min-width: 768px) {
                font-size: 1.75rem;
            }

            @media(min-width: 1024px) {
                font-size: 2rem;
            }
        }

        div.shortcuts {
            display: flex;

            a {
                font-family: "Inter", sans-serif;
                font-weight: 700;
                font-size: 1.125rem;
                color: var(--accent);
                display: flex;
                align-items: center;
                gap: 0.5em;

                transition-property: scale, opacity, background-color, color, transform;
                transition-duration: 250ms !important;

                justify-content: center;

                border: 3px solid var(--accent);
                border-radius: 0.75rem;
                background-color: #0000007D;
                padding: 1rem 3rem;
                width: min-content;
                text-wrap: nowrap;

                &:active {
                    scale: 0.9;
                }
            }

            /* Mobile */
            @media(max-width: 1024px) {
                flex-direction: column;
                gap: 1rem;
                a {
                    width: 100%;
                }
            }

            /* Desktop */
            @media(min-width: 1024px) {
                flex-direction: row;
                gap: 1rem;

                a {
                    &:hover {
                        background-color: var(--accent);
                        color: black;
                    }
                }
            }
        }
    }
</style>
