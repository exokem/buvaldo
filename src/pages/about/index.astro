<style lang="scss">
</style>

<style is:global>
    main#about {
        .cover {
			background-color: white;
            @media(max-width: 1024px) {
				background-position-y: 20px;
                background-position-x: calc(50%);
            }
			@media(min-width: 1024px) {
                background-position-y: 20px;
				background-position-x: -300px;
			}
			@media(min-width: 1281px) {
                background-position-y: 0px;
				background-position-x: -400px;
			}
        }
    }
</style>

<style lang="css">

    h1 {
        font-size: 2rem;
        font-weight: 700;
    }

    h2 {
        font-size: 1.5rem;
        font-weight: 700;
    }

    a.email {
        text-decoration: underline;
        color: dodgerblue;
    }

    div.p1 {
        background: linear-gradient(180deg, #00000000 75%, #0000007d 100%);
    }

    div.p2 {
        background: #0000007d;

        div.container {
            min-height: 0 !important;
			gap: 3rem;
            @media(max-width: 1024px) {
                gap: 1rem;
            }
            display: flex;
            flex-wrap: wrap;
            &.row {
                @media(min-width: 1024px) {
                    flex-wrap: nowrap;
					//height: 28rem;
                }
			}
            flex-direction: row;
            justify-content: center;

			&.portraits {
				display: grid;
                grid-template-columns: repeat(2, 1fr);
				@media(min-width: 1024px) {
                    grid-template-columns: repeat(4, 1fr);
                }
			}
        }

		img {
            border-radius: 1rem;
            filter: drop-shadow(0px 2px 4px #00000077);

			@media(min-width: 1024px) {
                //width: 32rem;

				&.bts {
                    width: calc((100% - 3rem) / 2);
				}

				&.portrait {
					width: calc((100% - 9rem) / 4);
				}
            }
		}

        @media(min-width: 1024px) {
            padding-bottom: 2.5rem;
		}
    }

	div.interviews-section {
        background: rgba(0, 0, 0, 0.72);
		backdrop-filter: blur(10px);
	}

	div.container {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem;

        div.bio {
            filter: drop-shadow(0px 2px 4px #00000077);
            background: #ffffffcc;
            backdrop-filter: blur(12px);
            padding: 2rem;
            border-radius: 1rem;

            font-family: "Inter", sans-serif;
            font-size: 1.125rem;

            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

		div.stack {
			display: flex;
			flex-direction: column;
			gap: 2rem;
		}

		div.interviews {
			h2 {
                font-family: "Permanent Marker", sans-serif;
				color: var(--accent);
				font-size: 2.5rem;
				@media(min-width: 1024px) {
                    font-size: 4rem;
				}
			}
            gap: 1rem;
            display: flex;
            flex-direction: column;
			align-items: center;

			& > * {
				width: 100%;
			}

			@media(max-width: 1024px) {
				flex-grow: 1;
            }
            @media(min-width: 1024px) {
                flex-basis: 75%;
                //width: 32rem;
            }
		}
	}

    div.row.container {
        flex-wrap: nowrap;
        max-width: 1280px;
        margin: 0 auto;
		padding: 0;

		display: grid !important;
		grid-template-columns: repeat(4, 1fr);
		justify-items: center;
		align-items: center;

		@media(max-width: 1024px) {
			grid-template-columns: repeat(2, 1fr);
			padding: 1rem;
        }

		&.second {
			@media(max-width: 1024px) {
				padding-bottom: 2rem;
            }
		}
    }

    div.container:has(div.bio) {
        min-height: calc(100vh - var(--nav-height));
        justify-content: end;
        @media(min-width: 1024px) {
            justify-content: center;
            align-items: end;
        }

        div.spacer {
            @media(max-width: 1024px) {
                height: 30rem;
            }
        }

        div.bio {
            @media(min-width: 1024px) {
                width: 32rem;
            }

            transition-property: opacity, transform;
            transition-duration: 500ms;
            transition-delay: 550ms;
            @starting-style {
                opacity: 0;
                transform: translateY(5rem);
            }
        }
    }

	p.credit {
		font-family: "Inter", sans-serif;
		color: white;
		font-size: 1.25rem;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(10px);
		padding: 1rem;
		border-radius: 1rem;
	}

	div.p2.images {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-bottom: 1rem;
        @media(min-width: 1024px) {
            gap: 3rem;
            padding-bottom: 3rem;
        }
		div.container {
			padding-top: 0 !important;
			padding-bottom: 0 !important;
		}
	}
</style>

<style is:global lang="scss">
	.row.first > div:first-child {
		grid-column-start: 1;
		grid-column-end: 3;
	}
	.row.second > div:nth-child(5) {
		grid-column-start: 1;
		grid-column-end: 3;
		@media(min-width: 1024px) {
			grid-column-start: 3;
			grid-column-end: 5;
		}
	}
</style>
