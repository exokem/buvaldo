---
import PageLayout from "../../layouts/PageLayout.astro";
import BackgroundCover from "../../components/BackgroundCover.astro";
import SocialLinks from "../../components/generic/SocialLinks.astro";

---

<PageLayout title='About'>
    <BackgroundCover src="/cover/about.jpg"/>
    <div class="p1">
        <div class="container">
            <div class="spacer"/>
            <div class="bio">
                <h1>About Bryan</h1>
                <p>
                    Bryan Uvaldo is an award-winning Brazilian-American filmmaker with a B.F.A.
                    in Film & Television from NYU Tisch.
                </p>
                <p>
                    Passionate for the action film genre, his action shorts
                    <em>Love Bomb Baby (2023)</em>
                    and
                    <em>Playin’ Around (2025)</em>,
                    have made splashy debuts at festivals around the globe with
                    the former winning Best Stunt Performance and the latter winning Best Editing and
                    Sound Design.
                </p>
                <p>
                    Bryan has edited a feature film, eleven short films, multiple promos for HBO Max,
                    and commercials for Pizza Hut and Taco Bell.

                    As an intern at Warner Bros. Discovery, Bryan worked as an editor for
                    the marketing campaigns of
                    <em>Pretty Little Liars: Original Sin</em>
                    and
                    <em>Edge of the Earth</em>.
                </p>
                <p>
                    Now based in LA, Bryan is currently a Post PA on Season 2 of ABC’s
                    <em>High Potential</em>, and
                    is determined to use his post-production experience as a building block for his path
                    to becoming a director for blockbuster films.
                </p>
                <p>
                    Email:
                    <a href="mailto:buvaldo216@gmail.com" class="email">buvaldo216@gmail.com</a>
                </p>
                <SocialLinks
                    youtube="https://www.youtube.com/channel/UCNDFgziSeSvF3CjxJxo7esg"
                    imdb="https://www.imdb.com/name/nm12071705/"
                    linkedin="https://www.linkedin.com/in/bryan-uvaldo-59827a1b9/"
                />
            </div>
        </div>
    </div>
    <div class="p2">
        <div class="container">
            <img src="/directorial/love-bomb-baby/bts-01.jpg"/>
            <img src="/directorial/playin-around/bts-01.jpg"/>
        </div>
    </div>
</PageLayout>

<style lang="scss">
</style>

<style is:global>
    main#about {
        .cover {
            @media(max-width: 1024px) {
                background-position-x: calc(50% - 25%);
            }
        }
    }
</style>

<style lang="css">

    h1 {
        font-size: 2rem;
        font-weight: 700;
    }

    a.email {
        text-decoration: underline;
        color: dodgerblue;
    }

    div.p1 {
        background: linear-gradient(180deg, #00000000 75%, #0000007d 100%);
    }

    div.p2 {
        background: #0000007d;

        div.container {
            min-height: 0 !important;
            gap: 2rem;
            display: flex;
            flex-wrap: wrap;
            flex-direction: row;
            justify-content: center;
        }

        img {
            border-radius: 1rem;
            filter: drop-shadow(0px 2px 4px #00000077);

            @media(min-width: 1024px) {
                width: 32rem;
            }
        }

        padding-bottom: 1rem;
    }

    div.container {
        max-width: 1280px;
        margin: 0 auto;
        min-height: calc(100vh - var(--nav-height));
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1rem;
        justify-content: end;
        @media(min-width: 1024px) {
            justify-content: center;
            align-items: end;
        }

        div.spacer {
            @media(max-width: 1024px) {
                height: 30rem;
            }
        }

        div.bio {

            filter: drop-shadow(0px 2px 4px #00000077);

            @media(min-width: 1024px) {
                width: 32rem;
            }

            background: #ffffffcc;
            backdrop-filter: blur(12px);
            padding: 2rem;
            border-radius: 0.5rem;

            font-family: "Inter", sans-serif;
            font-size: 1.125rem;

            display: flex;
            flex-direction: column;
            gap: 1rem;

            transition-property: opacity, transform;
            transition-duration: 500ms;
            transition-delay: 550ms;
            @starting-style {
                opacity: 0;
                transform: translateY(5rem);
            }
        }
    }
</style>
