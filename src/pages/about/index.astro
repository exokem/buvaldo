---
import PageLayout from "../../layouts/PageLayout.astro";
import BackgroundCover from "../../components/BackgroundCover.astro";
import SocialLinks from "../../components/generic/SocialLinks.astro";
import SpecialLink from "../../components/generic/SpecialLink.astro";
import Icon from "../../components/Icon.astro";
import ImageView from "../../components/generic/ImageView.astro";

const press = [
	["2026 DGA Student Spotlight Awards for Underrepresented Directors", "https://www.dga.org/events/2026/august2026/studentspotlightawards_2026", "editor_choice"],
	["2026 DGA Press Release Instagram", "https://www.instagram.com/p/DaBnvVsHId5/?igsh=NTc4MTIwNjQ2YQ%3D%3D&img_index=7", "article"],
	["Voyage LA Interview", "https://voyagela.com/interview/life-work-with-bryan-uvaldo-of-north-hollywood", "interpreter_mode"],
	["Sherman Oaks Red Carpet Interview", "https://vimeo.com/1147239591", "interpreter_mode"],
	["Sherman Oaks Film Festival Q&A", "https://vimeo.com/showcase/12028176?video=1147509521", "interpreter_mode"],
	["Podcast Interview on Fights with Friends ", "https://youtu.be/7v0jRKAOYbo?si=6J94JKM0BBsBFcur", "interpreter_mode"],
	["Fighting Spirit Film Festival Interview", "https://youtu.be/vMVw-b0zjPo?si=DeyCjfXLpiw_sQcG", "interpreter_mode"],
	["Discover Indie Film Podcast Interview", "https://discoverindiefilm.com/707-bryan-uvaldo-playin-around/", "interpreter_mode"],
	["Discover Indie Film 4Q’s Interview", "https://discoverindiefilm.com/708-4qs-with-bryan-uvaldo/", "interpreter_mode"],
	// ["", ""],
]

---

<PageLayout title='About'>
    <BackgroundCover src="/cover/about.jpg"/>
    <div class="p1">
        <div class="container">
            <div class="spacer"/>
            <div class="bio">
                <h1>About Bryan</h1>
                <p>
                    Bryan Uvaldo is an award-winning Brazilian-American filmmaker and DGA Award
					Finalist with a B.F.A. in Film & Television from NYU Tisch.
                </p>
                <p>
                    Passionate for the action film genre, his action shorts
                    <em>Love Bomb Baby (2023)</em>
                    and
                    <em>Playin’ Around (2025)</em>,
                    have made splashy debuts at festivals around the globe with the former
					winning Best Stunt Performance and the latter winning Best Editing,
					Sound Design and earning Bryan a nomination at the DGA Student Spotlight Awards.
                </p>
                <p>
                    Bryan has edited a feature film, twelve short films, multiple promos for
					HBO Max, and commercials for Pizza Hut and Taco Bell.

                    As an intern at Warner Bros. Discovery, Bryan worked as an editor for
                    the marketing campaigns of
                    <em>Pretty Little Liars: Original Sin</em>
                    and
                    <em>Edge of the Earth</em>.
                </p>
                <p>
                    Now based in LA, Bryan is currently a Post PA on Season 3 of ABC’s
                    <em>High Potential</em>, and
                    is determined to use his post-production experience as a building block for his path
                    to becoming a director for blockbuster films.
                </p>
                <p>
                    Email:
                    <a href="mailto:buvaldo216@gmail.com" class="email">buvaldo216@gmail.com</a>
                </p>
                <SocialLinks
                    youtube="https://www.youtube.com/channel/UCNDFgziSeSvF3CjxJxo7esg"
                    imdb="https://www.imdb.com/name/nm12071705/"
                    linkedin="https://www.linkedin.com/in/bryan-uvaldo-59827a1b9/"
                />
            </div>
        </div>
    </div>
	<div class="p2 images">
		<div class="first row container">
            <ImageView src="/about/lbb.jpg"/>
            <ImageView src="/about/portrait-1.JPG" alt="Bryan holding a lego camera stylistically"/>
            <ImageView src="/about/portrait-2.JPG" alt="Bryan in sunglasses crouching and directing"/>
		</div>
        <div class="second row container">
            <ImageView src="/about/portrait-3.JPG" alt="Bryan looking confused using a red corded phone"/>
            <ImageView src="/about/portrait-4.JPG" alt="Bryan sitting and joyfully playing with a lego biplane"/>
            <ImageView src="/about/photo-10.jpg"/>
        </div>
        <div class="container">
            <p class="credit">Bryan Uvaldo // Portraits by Carleigh Hyser</p>
        </div>
	</div>
    <!--<div class="p2">-->
    <!--    <div class="bts container">-->
    <!--        <img src="/directorial/love-bomb-baby/bts-01.jpg" class="bts"/>-->
	<!--		{[-->
	<!--			{path: "portrait-1", alt: "Bryan holding a lego camera stylistically"},-->
	<!--			{path: "portrait-2", alt: "Bryan in sunglasses crouching and directing"},-->
	<!--		].map(a => (<img src={`/about/${a.path}.JPG`} class="portrait" alt={a.alt}/>))}-->
    <!--    </div>-->
    <!--</div>-->
	<!--<div class="p2">-->
	<!--	<div class="bts container">-->
	<!--		{[-->
	<!--			{path: "portrait-3", alt: "Bryan looking confused using a red corded phone"},-->
	<!--			{path: "portrait-4", alt: "Bryan sitting and joyfully playing with a lego biplane"}-->
