    <div class="p2 interviews-section">
        <div class="container">
            <!--<img src="/about/bryan-portrait.jpg"/>-->
            <!--<div class="stack">-->
            <div class="interviews">
                <h2>Press Interviews</h2>
				{press.map(p => (<SpecialLink href={p[1]}>
                    <Icon>{p[2]}</Icon>
					{p[0]}
                </SpecialLink>))}
