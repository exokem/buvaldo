---
import type {Project} from "../../content.config";
import Icon from "../Icon.astro";
import ProjectPreview from "./ProjectPreview.astro";

interface Props {
	project: Project
}

const {
	project,
} = Astro.props

const checkId = `${project.id}-switch`
---

<input type="checkbox" class="preview-switch" id={checkId} hidden data-project={project.id}/>

<ProjectPreview project={project} class="preview">
    <label for={checkId} class="outside" slot="background-label"/>
    <label for={checkId} class="close" slot="close-label">
        <Icon size="2rem">close</Icon>
    </label>
</ProjectPreview>

<article id={project.id} class="thumbnail">
	<div class="placeholder">
		<div class="spinner"/>
	</div>
    <img src={project.display.landscape.src} alt={project.display.landscape.alt} />

    <h3 class="title">{project.metadata.title}</h3>
    <p class="subtitle">{project.metadata.genre} | {project.metadata.categories[0]}</p>

    <label class="thumbnail" for={checkId}></label>
</article>

<style>
	article.thumbnail  {
		@starting-style {
			opacity: 0;
			transform: translateY(1rem);
		}

		img {
			transition-property: opacity;
			transition-duration: 250ms;
			transition-delay: 500ms;
			transition-timing-function: ease-in-out;
			@starting-style {
				opacity: 0;
            }
		}
	}
</style>

<style is:global>
    input.preview-switch:checked {
        & + div.preview {
            opacity: 1;
            pointer-events: auto;
            article.preview {
                scale: 1;

                div.content > iframe {
                    display: flex;
                }
            }
        }
    }
</style>

<style lang="scss">
	label.outside {
		position: absolute;
		width: 100%;
		height: 100%;
	}

	label.close {

		height: 4rem;
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 0 1.5rem;
		cursor: pointer;
		transition-property: background-color;
		transition-duration: 250ms;
		&:hover {
			background-color: #ffffff33;
		}
	}

	div.placeholder {
		position: absolute;
		width: 100%;
		height: 100%;
		background: #00000099;

		div.spinner {
			@keyframes spin {
				0%   { transform: rotate(0deg);   animation-timing-function: cubic-bezier(0.55, 0.05, 0.67, 0.19); }
				70%  { transform: rotate(300deg); animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
				100% { transform: rotate(360deg); }
			}
			position: absolute;
			top: 50%;
			left: 50%;
			animation: spin 1s linear infinite;
			animation-play-state: running;

			&:before, &:after {
				content: '';
				display: block;
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 3rem;
				aspect-ratio: 1;
				border-radius: 50%;
				border: 4px solid transparent;
			}

			&:before {
				border-color: var(--accent);
				opacity: 0.2;
			}

			&:after {
				border-top: 4px solid var(--accent);
				opacity: 0.8;
				z-index: 2;
			}
		}
	}

	article.thumbnail {
		position: relative;

		filter: drop-shadow(0 1px 5px #00000099);

		--width: 390px;

		min-width: var(--width);
		width: var(--width);
		max-width: var(--width);

		aspect-ratio: 16 / 9;
		/*padding: 2.25rem;*/
		border-radius: 0.5rem;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: end;

		img {
			position: absolute;
			top: 0;
			left: 0;
		}

		h3.title, p.subtitle {
			z-index: 2;
			color: white;
			font-family: "Inter", sans-serif;
			background-color: rgba(0, 0, 0, 0.78);
			padding: 0.75rem;
			cursor: pointer;
		}

		h3.title {
			font-style: italic;
			padding-bottom: 0.25rem;
			font-size: 1.2rem;
			line-height: 1.2rem;
			text-overflow: ellipsis;
			overflow: hidden;
			text-wrap: nowrap;
		}

		p.subtitle {
			font-size: 0.9rem;
			line-height: 0.9rem;
			padding-top: 0.25rem;
			color: #AAA;
		}

		label.thumbnail {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			color: transparent;
		}

		transition-property: scale, opacity, transform;
		transition-duration: 250ms;

		@media(min-width: 1024px) {

			label.thumbnail {
				cursor: pointer;
			}

			&:hover {
				scale: 110%;
			}
		}
	}
</style>

<script>
	const inputs = document
		.querySelectorAll<HTMLInputElement>('input.preview-switch[data-project]')

	inputs.forEach(input => {
		input.addEventListener('change', (e) => {
			const key = input.dataset["project"]
			const embed = document.querySelector<HTMLInputElement>(`iframe[data-project=${key}]`);

			if (embed) {
				if (input.checked) {
					embed.style.display = "flex"
				} else {
					// noinspection SillyAssignmentJS
					embed.src = embed.src
				}
			}
		})
	})
</script>
