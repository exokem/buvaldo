---
import type {Project} from "../../content.config";
import SocialLinks from "../generic/SocialLinks.astro";
interface Props {
	project: Project
}

const {
	project
} = Astro.props

const traits = []

traits.push(...project.metadata.genre.split(" "))
traits.push(...project.metadata.categories)

const totalSeconds = project.metadata.duration.seconds
const totalMinutes = Math.floor(totalSeconds / 60) + project.metadata.duration.minutes

const hours = Math.floor(totalMinutes / 60) + project.metadata.duration.hours
const minutes = totalMinutes - (hours * 60)
const seconds = totalSeconds - (totalMinutes * 60)
---
<div class="root">
	<div class="main">
		{project.display.portrait && (
            <img src={project.display.portrait.src} alt="" class="poster"/>
		)}
        <div class="details">
            <h1 class="title">{project.metadata.title} (<span class="year">{project.metadata.year}</span>)</h1>
            <p class="traits">
				{traits.map((trait, i) => <>
                    <span class="value">{trait}</span>
					{i < traits.length - 1 ? <span class="unit">/</span> : <></>}
                </>)}
            </p>
            <p class="description">{project.metadata.description}</p>

            <p class="credits">
                <em>{project.metadata.roles}</em>
            </p>

			<div class="spacer"/>

            <div class="awards">
				{project.awards?.map((award) => (
                        <img class="award" src={award.laurel}/>
				))}
            </div>

            <div class="spacer"/>

			{project.socials && (
                    <SocialLinks
                            instagram={project.socials.instagram}
                            imdb={project.socials.imdb}
                            youtube={project.socials.youtube}
                            letterboxd={project.socials.letterboxd}
                    />
			)}
        </div>
	</div>
</div>

<style>
	div.root {
		display: flex;
		flex-direction: column;

		padding: 2rem;
		gap: 2rem;

        background: #00000066;
        backdrop-filter: blur(12px);
        border-radius: 0.5rem;
        border: 1px solid #00000066;

        transition-property: opacity, transform;
        transition-duration: 500ms;
        transition-delay: 350ms;
        @starting-style {
            opacity: 0;
            transform: translateY(5rem);
        }

		div.main {
            display: flex;
            flex-direction: column;
            gap: 2rem;

            @media(min-width: 1024px) {
                flex-direction: row;
            }

            img.poster {
                border-radius: 0.5rem;
                aspect-ratio: 250/369;
                background-color: black;
                flex-grow: 1;

				height: min-content;

                @media(max-width: 1024px) {
					max-width: 600px;
					align-self: center;
                }

                @media(max-width: 600px) {
                    max-width: 100%;

                }

                @media(min-width: 1280px) {
                }
            }

			div.spacer {
				flex-grow: 1;
			}
		}
	}

	div.awards {
		flex-grow: 1;
		max-width: 100%;
		display: flex;

		flex-direction: row;

		justify-content: center;
		align-items: center;

		flex-wrap: wrap;
		column-gap: 1rem;

		padding: 2rem 0;

		img.award {
            max-width: 120px;
		}
	}

	div.details {
		font-family: "Inter", sans-serif;
		color: white;

		display: flex;
		flex-direction: column;

		@media(min-width: 1024px) {
			padding-top: 2rem;
		}

		h1.title {
            font-size: 1.5rem;
            @media(min-width: 420px) {
                font-size: 2rem;
            }
            @media(min-width: 500px) {
                font-size: 2.5rem;
            }
			@media(min-width: 1160px) {
                font-size: 3rem;
			}
			font-weight: 700;

			span.year {
				opacity: 0.7 !important;
			}
		}

		p.credits {
            font-size: 1.5rem;
            line-height: 1.75rem;
			span.value {
				font-weight: 700;
			}
			opacity: 0.8;
            @media(max-width: 520px) {
                font-size: 1.15rem;
            }
		}

		p.traits {
            font-size: 0.75rem;
            margin-bottom: 1.5rem;

            @media(min-width: 420px) {
                font-size: 1.00rem;
            }
            @media(min-width: 500px) {
                font-size: 1.25rem;
            }

            @media(min-width: 1116px) {
                margin-bottom: 5rem;
            }


			& > span.value {
				&:nth-child(1) {
					font-weight: 700;
				}
                &:nth-child(3) {
                    font-weight: 700;
                }
			}
		}

        span.unit {
            font-weight: 400;
            opacity: 0.7;
        }

		span.runtime {
			span.unit {
				opacity: 1;
			}
			opacity: 0.7;
		}

		p.description {
			font-size: 1.5rem;
			line-height: 1.75rem;
            margin-bottom: 2rem;
		}
	}
</style>
