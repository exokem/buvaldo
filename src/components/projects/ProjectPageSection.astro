---
import CaptionedImage from "../generic/CaptionedImage.astro";

interface Props {
	id: string
	title?: string
	background?: string
}

const {
	id,
	title,
	background
} = Astro.props
---
<section id={id} class="sct" style={background ? `--bg-url: url("${background}")` : ""} data-has-bg={background ? "true" : "false"}>
    <div class="content">
		{title && <h2 class="heading-title">{title}</h2>}
        <slot/>
    </div>
</section>

<style>
    section.sct {
        div.content {
            max-width: 1280px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2rem;
            padding: 2rem 1rem;
        }
    }

    section#cover {
        min-height: calc(100vh - var(--nav-height));
        display: flex;
        align-items: center;
    }

	section.sct[data-has-bg="true"] {
        position: relative;
        --bg-url: "";
        &:before {
            content: "";
            position: absolute;
            z-index: -1;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;

            background-image: var(--bg-url);
            background-size: cover;
            background-repeat: no-repeat;

            background-position-x: calc(50%);
            filter: blur(4px) brightness(35%) saturate(150%);
        }
	}

    section#credits {
        z-index: 10;

        div.content {
            display: grid;
            grid-template-columns: min-content auto;

            h2 {
                grid-column-start: 1;
                grid-column-end: 3;
                justify-self: center;
            }
        }

        &:before {
            //filter: drop-shadow(0 1px 4px #00000066);
        }
    }
</style>
