---
import {getProject} from "../../content.config";
import BackgroundCover from "../BackgroundCover.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import FilmDetails from "./FilmDetails.astro";
import CaptionedImage from "../generic/CaptionedImage.astro";
import ProjectCredits from "./ProjectCredits.astro";
import ProjectImages from "./ProjectImages.astro";
import ProjectPageSection from "./ProjectPageSection.astro";
import ImageCaption from "../generic/ImageCaption.astro";
import Icon from "../Icon.astro";
import ImageCarousel from "./ImageCarousel.astro";
interface Props {
	name: string
}

const {
	name
} = Astro.props

const project = await getProject(name)


const page = project.page!
---
<PageLayout title={project.metadata.title} style={`--cover-url: url("/cover/${project.id}.jpg");`}>
    <BackgroundCover src={`/cover/${project.id}.jpg`} blur/>
    <nav class="contents" aria-labelledby="contents-label">
        <span id="contents-label" hidden>Table of Contents</span>
        <ol role="list">
            <li><a href="#cover">{project.metadata.title}</a></li>
            <li><a href="#details">Details</a></li>
			{project.display.embed && (
                    <li><a href="#watch-now">Watch Now</a></li>
			)}
            <li><a href="#stills">Film Stills</a></li>
            <li><a href="#bts">Behind the Scenes</a></li>
            <li><a href="#trailer">Trailer</a></li>
            <li><a href="#extras">Extras</a></li>
			<span class="material-symbols-rounded icon" aria-hidden="true">toc</span>
        </ol>
    </nav>
	<ProjectPageSection id="cover">
		<div class="cover-content">
            <h1 class="title heading-title">{project.metadata.title}</h1>
		</div>
	</ProjectPageSection>
	<ProjectPageSection id="details" title="details">
        <FilmDetails project={project}/>
	</ProjectPageSection>
	{project.display.embed && (
		<ProjectPageSection id="watch-now" title="Watch Now">
            <div id="film-embed">
                <iframe
					src={project.display.embed.src}
					title="YouTube video player"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
                />
			</div>
		</ProjectPageSection>
	)}
	<ProjectPageSection id="stills" title="Stills">
		<ImageCarousel
			folder={page.folder}
			images={page.stills.images}
			id="images-stills"
			aspect="48/25"
		/>
	</ProjectPageSection>
    <ProjectPageSection id="bts" title="BTS">
        <ImageCarousel
			folder={page.folder}
			images={page.bts.images}
			id="images-bts"
            aspect="3/2"
		/>
    </ProjectPageSection>
	<ProjectPageSection id="trailer" title="trailer" background={page.credits.background}>
		<!--<ProjectCredits project={project}/>-->
		{page.trailer && (
                <div id="trailer">
                    <iframe
                            src={page.trailer}
                            title="YouTube video player"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
                    />
                    <ImageCaption overlay={false}>
                        <em>Teaser Trailer</em>
                    </ImageCaption>
                </div>
		)}
	</ProjectPageSection>
	<ProjectPageSection id="extras" title="Extras" background={page.extras.background}>
		<slot name="extras"/>
		{page.presskit && (
			<a href={`/epk/${project.id}-epk.pdf`} class="shortcut-button">
				<Icon>download</Icon>
				Download EPK
			</a>
		)}
    </ProjectPageSection>
</PageLayout>

<style>
	div.cover-content {
		max-width: 1280px;
		@media(min-width: 1280px) {
			width: 100%;
		}
        color: black;

		width: 100%;
		display: flex;
		justify-content: center;

		@media(min-width: 1024px) {
            justify-content: start;
			margin: 0 auto;
		}
		padding: 2rem 1rem;
        h1.title {
            font-size: 2.25rem;
			font-family: "Passion One", cursive;
			text-transform: uppercase;
            @media(min-width: 420px) {
                font-size: 3rem;
            }
            @media(min-width: 500px) {
                font-size: 3.75rem;
            }
            @media(min-width: 1024px) {
                font-size: 7rem;
                line-height: 7rem;
            }
            font-weight: 700;
            filter: drop-shadow(0px 1px 3px #000000FF);
        }

        p.traits {
            font-size: 0.75rem;

            @media(min-width: 420px) {
                font-size: 1.00rem;
            }
            @media(min-width: 500px) {
                font-size: 1.25rem;
            }

			opacity: 0.8;


            & > span.value {
                &:nth-child(1) {
                    font-weight: 700;
                }
                &:nth-child(3) {
                    font-weight: 700;
                }
            }
        }
	}

	div#presskit, div#trailer {
        width: 100%;
        border: none;
        border-radius: 0.5rem;
        overflow: clip;
        position: relative;
        background: #00000066;
        backdrop-filter: blur(12px);
        iframe {
            width: 100%;
        }
	}

	div#trailer > iframe {
        aspect-ratio: 16/9;
	}

	div#presskit > iframe {
		aspect-ratio: 5/5;
	}

	div#film-embed {
		width: 100%;
        border-radius: 0.5rem;
        background: #00000066;
        backdrop-filter: blur(12px);
        iframe {
            width: 100%;
            aspect-ratio: 16/9;
            border-radius: 0.5rem;
        }
	}

    nav.contents {
		@media(max-width: 1024px) {
			display: none;
		}
        ol {
			span.icon {
				position: absolute;
				top: 0;
				left: -1rem;
				padding: 0.75rem;
				width: 100%;
				height: 50%;
				font-size: 3rem;
				user-select: none;

                transition-property: opacity;
                transition-duration: 500ms;
				opacity: 0;
				z-index: -1;
				align-content: center;
                background-color: #00000099;
                border-radius: 0.5rem 0 0 0.5rem;
                border: 1px solid #00000066;
			}

            z-index: 100;
            right: 0;
            margin-top: 2rem;
            background-color: #000000aa;
            border-radius: 0.5rem 0 0 0.5rem;
            border: 1px solid #00000066;
            padding: 3rem;
            position: fixed;
            top: var(--nav-height);
            height: min-content;
            display: flex;
            flex-direction: column;
            gap: 1rem;

            font-family: "Inter", sans-serif;
            font-size: 1.5rem;
            line-height: 1.5rem;
            font-weight: 700;
            color: white;
            @media(max-width: 1970px) {
                transform: translateX(calc(100% - 3.5rem));
				background-color: #00000001;
				border-color: transparent;
				span.icon {
					opacity: 1;
				}

				&:hover {
                    background-color: #000000aa;
                    border: 1px solid #00000066;
                    transform: none;
                    backdrop-filter: blur(12px);

					span.icon {
						opacity: 0;
					}
				}
            }

            li > a {
                width: 100%;
                display: inline-block;
                position: relative;
                padding: 0.5rem 0.75rem;
				padding-left: 3rem;
                @media(min-width: 1024px) {
                    cursor: pointer;
                    &::before {
                        content: "";
                        border-radius: 0.5rem;
                        position: absolute;
                        transition-property: width, left;
                        transition-duration: 300ms;
                        height: 100%;
                        top: 50%;
                        left: 0;
                        width: 0;
                        transform: translate(-50%, -50%);
                        opacity: 0.6;
                        z-index: -1;
                        background-image: linear-gradient(to right, var(--accent) 70%, transparent)
                    }
                    &:hover {
                        &::before {
                            width: 100%;
                            left: 50%;
                        }
                    }
                }
            }

            transition-property: opacity, transform, backdrop-filter, background-color, border-color;
            transition-duration: 500ms;
            @starting-style {
                opacity: 0;
                transform: translate(5rem);
                @media(max-width: 1970px) {
                    transform: translateX(calc(100% - 3.5rem));
                }
                transition-delay: 350ms;
            }
        }
    }
</style>
