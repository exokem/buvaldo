---
import {getProject} from "../../content.config";
import BackgroundCover from "../BackgroundCover.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import FilmDetails from "./FilmDetails.astro";
import CaptionedImage from "../generic/CaptionedImage.astro";
import ProjectCredits from "./ProjectCredits.astro";
import ProjectImages from "./ProjectImages.astro";
import ProjectPageSection from "./ProjectPageSection.astro";
import ImageCaption from "../generic/ImageCaption.astro";
import Icon from "../Icon.astro";
interface Props {
	name: string
}

const {
	name
} = Astro.props

const project = await getProject(name)


const page = project.page!
---
<PageLayout title={project.metadata.title}>
    <BackgroundCover src={`/cover/${project.id}.jpg`} blur/>
    <nav class="contents" aria-labelledby="contents-label">
        <span id="contents-label" hidden>Table of Contents</span>
        <ol role="list">
            <li><a href="#cover">{project.metadata.title}</a></li>
			{project.display.embed && (
                    <li><a href="#watch-now">Watch Now</a></li>
			)}
            <li><a href="#stills">Film Stills</a></li>
            <li><a href="#bts">Behind the Scenes</a></li>
            <li><a href="#trailer">Trailer</a></li>
            <li><a href="#extras">Extras</a></li>
        </ol>
    </nav>
	<ProjectPageSection id="cover">
        <FilmDetails project={project}/>
	</ProjectPageSection>
	{project.display.embed && (
		<ProjectPageSection id="watch-now" title="Watch Now">
            <div id="film-embed">
                <iframe
					src={project.display.embed.src}
					title="YouTube video player"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
                />
			</div>
		</ProjectPageSection>
	)}
	<ProjectPageSection id="stills" title="Stills">
		<ProjectImages folder={page.folder} images={page.stills.images}/>
	</ProjectPageSection>
    <ProjectPageSection id="bts" title="BTS">
        <ProjectImages folder={page.folder} images={page.bts.images}/>
    </ProjectPageSection>
	<ProjectPageSection id="trailer" title="trailer" background={page.credits.background}>
		<!--<ProjectCredits project={project}/>-->
		{page.trailer && (
                <div id="trailer">
                    <iframe
                            src="https://www.youtube.com/embed/eqISelyErS0?si=j5Yg8mxe9_UxxAo9"
                            title="YouTube video player"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
                    />
                    <ImageCaption overlay={false}>
                        <em>Teaser Trailer</em>
                    </ImageCaption>
                </div>
		)}
	</ProjectPageSection>
	<ProjectPageSection id="extras" title="Extras" background={page.extras.background}>
        <ProjectImages folder={page.folder} images={page.extras.images}/>
		<slot name="extras"/>
		{page.presskit && (
			<a href={`/epk/${project.id}-epk.pdf`} class="shortcut-button">
				<Icon>download</Icon>
				Download EPK
			</a>
		)}
    </ProjectPageSection>
</PageLayout>

<style>
	div#presskit, div#trailer {
        width: 100%;
        border: none;
        border-radius: 0.5rem;
        overflow: clip;
        position: relative;
        background: #00000066;
        backdrop-filter: blur(12px);
        iframe {
            width: 100%;
        }
	}

	div#trailer > iframe {
        aspect-ratio: 16/9;
	}

	div#presskit > iframe {
		aspect-ratio: 5/5;
	}

	div#film-embed {
		width: 100%;
        border-radius: 0.5rem;
        background: #00000066;
        backdrop-filter: blur(12px);
        iframe {
            width: 100%;
            aspect-ratio: 16/9;
            border-radius: 0.5rem;
        }
	}

    nav.contents {
        @media(max-width: 1024px) {
            display: none;
        }
        ol {
            z-index: 100;
            right: 0;
            margin: 2rem;
            background: #00000066;
            backdrop-filter: blur(12px);
            border-radius: 0.5rem;
            border: 1px solid #00000066;
            padding: 1rem 1rem;
            position: fixed;
            bottom: 0;
            @media(min-width: 1920px) {
                top: 50%;
                transform: translateY(-50%);
            }
            height: min-content;
            display: flex;
            flex-direction: column;
            gap: 1rem;

            font-family: "Inter", sans-serif;
            font-size: 1.5rem;
            line-height: 1.5rem;
            font-weight: 700;
            color: white;

            li > a {
                width: 100%;
                display: inline-block;
                position: relative;
                padding: 0.5rem 0.75rem;
                @media(min-width: 1024px) {
                    cursor: pointer;
                    &::before {
                        content: "";
                        border-radius: 0.5rem;
                        position: absolute;
                        transition-property: width, left;
                        transition-duration: 300ms;
                        height: 100%;
                        top: 50%;
                        left: 0;
                        width: 0;
                        transform: translate(-50%, -50%);
                        opacity: 0.6;
                        z-index: -1;
                        background-image: linear-gradient(to right, var(--accent) 70%, transparent)
                    }
                    &:hover {
                        &::before {
                            width: 100%;
                            left: 50%;
                        }
                    }
                }
            }

            transition-property: opacity, transform;
            transition-duration: 500ms;
            transition-delay: 350ms;
            @starting-style {
                opacity: 0;
                transform: translate(5rem, -50%);
            }
        }
    }
</style>
