---
import Icon from "../Icon.astro";
import type {Project} from "../../content.config";

interface Props {
	project: Project
    class?: string
}

const {
	project,
    class: className,
} = Astro.props
---
<div class:list={["preview", className]} id={`${project.id}-popup-container`}>
	<slot name="background-label"/>
    <!--<label for={checkId} class="outside"/>-->
    <article class="preview" id={`${project.id}-preview`}>
        <div class="titlebar">
            <h3>
                <Icon size="2rem">movie</Icon>
                <span>Preview - {project.metadata.title}</span>
            </h3>
			<slot name="close-label"/>
            <!--<label for={checkId} class="close">-->
            <!--    <Icon size="2rem">close</Icon>-->
            <!--</label>-->
        </div>
        <div class="content">
			{project.display.embed && (
                    <iframe src={project.display.embed.src} allowfullscreen data-project={project.id}/>
			)}
			{project.display.embed === undefined && (
                    <div class="coming-soon">
                        <p>Coming Soon</p>
                    </div>
			)}
        </div>
    </article>
</div>

<style lang="scss">
	div.preview {
		display: flex;
		z-index: 999;
		transition-property: opacity;
		transition-duration: 250ms;

		position: fixed;
		pointer-events: none;
		opacity: 0;
		top: var(--nav-height);
		left: 0;
		width: 100%;
		height: calc(100% - var(--nav-height));
		background-color: #0000007D;
		backdrop-filter: blur(10px);

		label.outside {
			position: absolute;
			width: 100%;
			height: 100%;
		}

		article.preview {
			transition-property: scale;
			transition-duration: 250ms;
			z-index: 10;
			scale: 0.5;
			border-radius: 0.5rem;
			overflow: clip;
			background-color: var(--accent);

			max-width: 1280px; margin: auto auto;

			--width: 440px;

			@media(min-width: 1024px) {
				--width: 900px;
			}

			@media(min-width: 1280px) {
				--width: 1100px;
			}

			width: var(--width);

			div.titlebar {
				background: var(--accent);

				display: flex;
				flex-direction: row;
				justify-content: space-between;

				h3 {
					padding: 1rem;
					font-family: "Inter", sans-serif;
					font-size: 1.5rem;
					line-height: 1.5rem;
					font-weight: 700;
					color: black;
					display: inline-flex;
					flex-direction: row;
					align-items: center;
					gap: 0.75rem;
					max-width: calc(var(--width) - 80px);

					span:last-child {
						text-overflow: ellipsis;
						overflow: hidden;
						line-height: 1.75rem;
						text-wrap: nowrap;
					}
				}

				label.close {

					height: 4rem;
					display: flex;
					justify-content: center;
					align-items: center;
					padding: 0 1.5rem;
					cursor: pointer;
					transition-property: background-color;
					transition-duration: 250ms;
					&:hover {
						background-color: #ffffff33;
					}
				}
			}

			div.content {
				background-color: black;
				border-radius: 0.5rem;
				border: 3px solid var(--accent);
				overflow: clip;
				padding: 0.5rem;

				min-height: 250px;

				@media(min-width: 1024px) {
					min-height: 495px;
				}

				@media(min-width: 1280px) {
					min-height: 607px;
				}

				iframe {
					aspect-ratio: 16 / 9;
					display: none;
					width: 100%;
					border: none;

					&:focus {
						outline: none;
					}
				}

				div.coming-soon {
					aspect-ratio: 16 / 9;
					width: 100%;
					display: flex;
					flex-direction: column;
					justify-content: center;
					align-items: center;
					background: repeating-linear-gradient(45deg,
							#ffffff0a 0 32px,
							transparent 32px 64px
					);
					p {
						font-family: "Permanent Marker", sans-serif;
						font-weight: 700;
						font-size: 3rem;
						line-height: 2rem;
						color: var(--accent);
					}
				}
			}
		}
	}
</style>
