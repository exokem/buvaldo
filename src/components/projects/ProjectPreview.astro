---
import Icon from "../Icon.astro";
import type {Project} from "../../content.config";

interface Props {
	project: Project
    class?: string
}

const {
	project,
    class: className,
} = Astro.props

const checkId = `${project.id}-details-switch`
---
<div class:list={["preview", className]} id={`${project.id}-popup-container`}>
	<slot name="background-label"/>
    <article class="preview" id={`${project.id}-preview`}>
        <div class="titlebar">
            <h3>
                <Icon size="2rem">movie</Icon>
                <span>Preview - {project.metadata.title}</span>
            </h3>
			<slot name="close-label"/>
        </div>
        <div class="content">
			{project.display.embed && (
                    <iframe src={project.display.embed.src} allowfullscreen data-project={project.id}/>
			)}
			{project.display.embed === undefined && (
                    <div class="coming-soon">
                        <p>Coming Soon</p>
                    </div>
			)}
            <input type="checkbox" id={checkId} class="details-switch" hidden/>
            <label for={checkId} class="details-label">
                <span class="show sym">visibility</span>
                <span class="hide sym">visibility_off</span>
                <span class="show label">Show Details</span>
                <span class="hide label">Hide Details</span>
            </label>

            <div class="details">
                <div>
                    <label for={checkId} class="details-close">
                        <span class="sym">close</span>
                    </label>
                    <h3 class="title">
                        <em>{project.metadata.title}</em>
                    </h3>
                    <p class="subtitle">
                        <b>{project.metadata.year}</b>
                        | {project.metadata.genre}
                        {project.metadata.categories[0] && (
                            <>
                                | <em>{project.metadata.categories[0]}</em>
                            </>
                        )}
                    </p>
                    <hr/>
                    <p class="description">
                        {project.metadata.description}
                    </p>
                </div>
            </div>
        </div>
    </article>
</div>

<style lang="scss">
    div.details {
        position: absolute;
        top: 0;
        left: 0;

        opacity: 0;
        transition-property: opacity;
        transition-duration: 250ms;
        pointer-events: none;

        /*margin: 0.5rem;*/
        height: 100%;
        width: 100%;
        border-radius: 0.5rem;
        background: #00000077;
        backdrop-filter: blur(8px);
        display: flex;
        align-items: center;
        justify-content: center;

        div {
            position: relative;
            color: white;
            font-family: "Inter", sans-serif;
            display: flex;
            flex-direction: column;
            background-color: #000000cc;
            padding: 2.25rem;
            border-radius: 0.5rem;
            width: 75%;
            gap: 1rem;

            label.details-close {
                position: absolute;
                font-size: 1.5rem;
                right: 0;
                top: 0;
                padding: 1rem;
                cursor: pointer;

                .sym {
                    transition-property: opacity;
                    transition-duration: 250ms;
                }

                &:hover {
                    .sym {
                        opacity: 0.9;
                    }
                }
            }

            h3.title {
                font-size: 2rem;
                font-weight: 700;
            }

            p.subtitle {
                font-size: 1.5rem;
                color: rgb(168 162 158);
            }

            p.description {
                font-size: 1.25rem;
            }
        }
    }

    label.details-label {
        position: absolute;
        z-index: 999;
        background-color: var(--accent);
        padding: 0.75rem;
        border-radius: 0.5rem;
        cursor: pointer;
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.75rem;
        left: 50%;
        bottom: 0;
        transform: translateX(-50%) translateY(50%);
        transition-property: background-color;
        transition-duration: 250ms;
        filter: drop-shadow(0 1px 4px #00000055);

        &:hover {
            background-color: #fccc50;
        }

        span {
            line-height: 1.25rem;
            user-select: none;
        }

        span.sym {
            font-size: 1.5rem;
        }

        span.label {
            font-size: 1.25rem;
            font-weight: 700;
        }

        span.hide {
            display: none;
        }

        span.show {
            display: inline-block;
        }
    }

    input.details-switch:checked + label.details-label {
        span.show {
            display: none;
        }

        span.hide {
            display: inline-block;
        }
    }

    input.details-switch:checked ~ div.details {
        opacity: 1;
        pointer-events: auto;
    }

	div.preview {
		display: flex;
		z-index: 999;
		transition-property: opacity;
		transition-duration: 250ms;

		position: fixed;
		pointer-events: none;
		opacity: 0;
		top: var(--nav-height);
		left: 0;
		width: 100%;
		height: calc(100% - var(--nav-height));
		background-color: #0000007D;
		backdrop-filter: blur(10px);

		label.outside {
			position: absolute;
			width: 100%;
			height: 100%;
		}

		article.preview {
            position: relative;
			transition-property: scale;
			transition-duration: 250ms;
			z-index: 10;
			scale: 0.5;
			border-radius: 0.5rem;
			/*overflow: clip;*/
			background-color: var(--accent);

			max-width: 1280px; margin: auto auto;

			--width: 440px;

			@media(min-width: 1024px) {
				--width: 900px;
			}

			@media(min-width: 1280px) {
				--width: 1100px;
			}

			width: var(--width);

			div.titlebar {
				background: var(--accent);
                border-radius: 0.5rem 0.5rem 0 0;
                overflow: clip;

				display: flex;
				flex-direction: row;
				justify-content: space-between;

				h3 {
					padding: 1rem;
					font-family: "Inter", sans-serif;
					font-size: 1.5rem;
					line-height: 1.5rem;
					font-weight: 700;
					color: black;
					display: inline-flex;
					flex-direction: row;
					align-items: center;
					gap: 0.75rem;
					max-width: calc(var(--width) - 80px);

					span:last-child {
						text-overflow: ellipsis;
						overflow: hidden;
						line-height: 1.75rem;
						text-wrap: nowrap;
					}
				}

				label.close {

					height: 4rem;
					display: flex;
					justify-content: center;
					align-items: center;
					padding: 0 1.5rem;
					cursor: pointer;
					transition-property: background-color;
					transition-duration: 250ms;
					&:hover {
						background-color: #ffffff33;
					}
				}
			}

			div.content {
                position: relative;
				background-color: black;
				border-radius: 0.5rem;
				border: 3px solid var(--accent);
				/*overflow: clip;*/
				padding: 0.5rem;

				min-height: 250px;

				@media(min-width: 1024px) {
					min-height: 495px;
				}

				@media(min-width: 1280px) {
					min-height: 607px;
				}

				iframe {
					aspect-ratio: 16 / 9;
					display: none;
					width: 100%;
					border: none;
                    border-radius: 0.5rem;

					&:focus {
						outline: none;
					}
				}

				div.coming-soon {
					aspect-ratio: 16 / 9;
					width: 100%;
					display: flex;
					flex-direction: column;
					justify-content: center;
					align-items: center;
					background: repeating-linear-gradient(45deg,
							#ffffff0a 0 32px,
							transparent 32px 64px
					);
					p {
						font-family: "Permanent Marker", sans-serif;
						font-weight: 700;
						font-size: 3rem;
						line-height: 2rem;
						color: var(--accent);
					}
				}
			}
		}
	}
</style>
