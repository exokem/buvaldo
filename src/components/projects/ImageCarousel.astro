---
import type {ProjectImagesArray} from "../../content.config";
import ImageCaption from "../generic/ImageCaption.astro";
import CaptionedImage from "../generic/CaptionedImage.astro";
interface Props {
	folder: string
	images: ProjectImagesArray
	id: string
	aspect: string
}

const {
	folder,
	images,
	id,
	aspect,
} = Astro.props
---
<div class="image-list-clip-wrapper">
    <div class="image-list" style={`--aspect-ratio: ${aspect}`}>
		{images.map((image, i) => (
                <div class="slide" id={`${id}-slide-${i}`}>
                    <CaptionedImage folder={image.folder ?? folder} name={image.name} alt={image.description ?? ""}>
						{image.description !== null && (
                                <ImageCaption>
                                    <em>{image.description}</em>
									{image.credit && (
                                            <span> &mdash; {image.credit}</span>
									)}
                                </ImageCaption>
						)}
                    </CaptionedImage>
					{0 < i && (
                            <a href={`#${id}-slide-${i - 1}`} class="button prev">
						<span class="material-symbols-rounded icon">
							chevron_left
						</span>
                            </a>
					)}
					{i + 1 < images.length && (
                            <a href={`#${id}-slide-${i + 1}`} class="button next">
						<span class="material-symbols-rounded icon">
							chevron_right
						</span>
                            </a>
					)}
                </div>
		))}
    </div>
</div>

<style>
    div.image-list-clip-wrapper {
        max-width: 80%;
        width: 80%;
        aspect-ratio: var(--aspect-ratio);
        border-radius: 0.5rem;
        overflow: clip;
    }

    div.image-list {
        position: relative;
        margin: 0 auto;
        display: flex;
        gap: 2rem;
        flex-direction: row;
        overflow: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scroll-snap-align: center;

        div.slide {
            position: relative;
            height: 100%;
            min-width: 100%;
            scroll-snap-align: center;
            scroll-margin-top: calc(var(--nav-height) * 2);
        }

        a.button {
            position: absolute;
            top: 0;
            height: 100%;

            display: flex;
            align-items: center;

            span.icon {
                position: relative;
                scale: 1;
                font-size: 4rem;
                color: white;
                text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
                filter: drop-shadow(0px 2px 2px #00000077);
            }

            &:before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;

                transition-property: opacity;
                transition-duration: 250ms;
                border-radius: 0.5rem;
            }

            &:hover:before {
                opacity: 1;
            }

            &.prev {
                left: 0;
                &:before {
                    background-image: linear-gradient(to right, #00000077, transparent);
                }
            }

            &.next {
                right: 0;
                &:before {
                    background-image: linear-gradient(to left, #00000077, transparent);
                }
            }
        }
    }
</style>
