---
import {getDirectorialProjects, getEditorialProjects} from "../../content.config";
import type {Project} from "../../content.config";
import ProjectCard from "./ProjectCard.astro";

interface Props {
	type: string
	section: string
}

const {
	type,
	section,
} = Astro.props


let items: Project[] = [];

if (type === "editorial") {
	items = await getEditorialProjects();
} else if (type === "directorial") {
	items = await getDirectorialProjects();
}

const filtered = items.filter(i => i.metadata.section === section)
---
<section class="section" id={section}>
	<h2 class="heading-title">{section}</h2>
	<div class="projects">
		{filtered.map(item => (
			<ProjectCard project={item}/>
		))}
	</div>
</section>

<style lang="scss">
	section.section {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1rem 2rem;

		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;

		h2 {
			font-size: 3rem;
			line-height: 3rem;
		}

		div.projects {
			gap: 2rem;

			display: grid;

			@media(min-width: 920px) {
				grid-template-columns: repeat(2, 1fr);
			}

			@media(min-width: 1280px) {
				grid-template-columns: repeat(3, 1fr);
				width: 100%;
			}
		}
	}
</style>
