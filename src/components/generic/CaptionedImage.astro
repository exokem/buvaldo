---
interface Props {
	folder: string
	name: string
	alt: string
}

const {
	folder,
	name,
	alt,
} = Astro.props
---
<div class="captioned-image">
	<img src={`/${folder}/${name}`} alt={alt} />
	<slot/>
</div>

<style>
	div.captioned-image {
		position: relative;
		border-radius: 0.5rem;
		overflow: clip;

		& > img {

		}
	}
</style>
