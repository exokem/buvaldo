---
interface Props {
    overlay?: boolean
}

const {
    overlay = true
} = Astro.props
---
<p class="caption" style={`--position: ${overlay ? "absolute" : "relative"}`}>
    <slot/>
</p>

<style>
    p.caption {
        --position: absolute;
        @media(min-width: 1024px) {
            position: var(--position);
        }
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.78);
        padding: 0.75rem;
        width: 100%;


        font-family: "Inter", sans-serif;
        color: white;
    }
</style>
