---
interface Props {
    overlay?: boolean
}

const {
    overlay = true
} = Astro.props
---
<p class="caption" style={`--position: ${overlay ? "absolute" : "relative"}`}>
    <slot/>
</p>

<style>
    p.caption {

        bottom: 0;
        background-color: rgba(0, 0, 0, 0.78);
        padding: 0.75rem;
        width: 100%;
        flex-grow: 1;

        justify-content: center;
        align-content: center;

        @media(max-width: 1024px) {
            font-size: 0.9rem;
        }

        font-family: "Inter", sans-serif;
        color: white;
    }
</style>
