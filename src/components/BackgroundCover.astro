---
interface Props {
	src: string,
	blur?: boolean
}

const {
	src,
	blur = false
} = Astro.props
---
<div class:list={["cover", blur ? "blurred" : ""]} style={`--src: url(${src})`}/>

<style lang="css">
	div.cover {
        transition-property: opacity;
        transition-duration: 0.75s;
        transition-timing-function: ease-in-out;

        @starting-style {
            opacity: 0;
        }

		--src: url("/");
        position: fixed;
        top: 0;
        z-index: -1;
		width: 100%;
		height: 100%;
		background-image: var(--src);
		background-position: top;
		background-size: cover;
		filter: saturate(125%);
	}

    .blurred {
        filter: blur(4px) brightness(35%) saturate(150%) !important;
    }
</style>
