---

import Icon from "./Icon.astro";---
<nav class="highlight-gradient">
	<header class="limited">
		<ul id="top">
			<li id="brand" class="brand">
                <a href="/">
                    <p>BRYAN UVALDO</p>
                    <p>DIRECTOR. EDITOR.</p>
				</a>
			</li>
			<li/>
			<li class="desktop item"><a href="/directorial"><span>DIRECTORIAL</span></a></li>
			<li class="desktop item"><a href="/editorial"><span>EDITORIAL</span></a></li>
			<li class="desktop item"><a href="/about"><span>ABOUT</span></a></li>
			<li class="mobile">
				<button id="menu-button">
                    <Icon id="close-menu">close</Icon>
                    <Icon id="open-menu">menu</Icon>
				</button>
			</li>
		</ul>
		<ul class="mobile" id="drawer">
            <li class="item"><a href="/directorial">DIRECTORIAL</a></li>
            <li class="item"><a href="/editorial">EDITORIAL</a></li>
            <li class="item"><a href="/about">ABOUT</a></li>
		</ul>
	</header>
</nav>

<style>
	nav {
		position: fixed;
		top: 0;
		display: flex;
		flex-direction: row;
		width: 100vw;
		z-index: 9000;
        height: var(--nav-height);
	}

	header {
		height: var(--nav-height);
		flex-grow: 1;
		margin: auto;

		ul#top {
			display: flex;
			flex-direction: row;
			gap: 1.5rem;
			height: var(--nav-height);
			li:nth-child(2) {
				flex-grow: 1;
            }
		}
	}

	li {
		font-weight: 700;
		font-family: "Inter", sans-serif;
		font-size: 1.25rem;
		line-height: 1.75rem;

        & > a {
            height: var(--nav-height);
            transition-duration: 250ms;
            transition-property: opacity;
            transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
			display: flex;
			align-items: center;
			justify-content: center;

            &:hover {
                opacity: 0.8;
            }

			span {
				position: relative;
				padding: 0.5rem 0.75rem;
				&::before {
                    content: "";
                    position: absolute;
					transition-property: width, left;
					transition-duration: 300ms;
                    height: 100%;
					top: 50%;
					left: 0;
					width: 0;
					transform: translate(-50%, -50%);
                    opacity: 0.4;
                    z-index: -1;
					background-image: linear-gradient(to right, #fde047 70%, transparent)
                }

				&:hover {
					&::before {
						width: 100%;
						left: 50%;
					}
				}
			}
        }
	}

	li.mobile {
		position: relative;
		@media(min-width: 1024px) {
			display: none;
		}
		button {
			height: var(--nav-height);
			cursor: pointer;
			aspect-ratio: 1/1;
		}

		.icon {
			position: absolute;
			top: 0;
			left: 0;
			display: flex;
			justify-content: center;
			align-items: center;
			font-size: 2.5rem;
			width: 100%;
			aspect-ratio: 1 / 1;
			transition-property: opacity, scale;
			transition-duration: 250ms;
			transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		}
	}

	#drawer {
		overflow: hidden;
		transition-property: height, max-height;
		transition-duration: 250ms;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
		backdrop-filter: blur(24px);
		background-color: #0000007D;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 5rem;
		padding: 0 2.5rem;
        @media(min-width: 1024px) {
            display: none;
        }

		.item > a {
            border: 3px solid var(--accent);
			color: var(--accent);
			border-radius: 0.75rem;
		}
	}

	#brand > a {
		display: flex;
		flex-direction: column;
		align-items: start;
		justify-content: center;
		p:first-child {
			font-family: "Passion One", sans-serif;
			font-weight: 700;
			font-size: 3.75rem;
            @media(max-width: 1024px) {
				font-size: 3rem;
            }
            @media(max-width: 512px) {
                font-size: 2.5rem;
            }
			font-style: normal;
			line-height: 1;
        }

		p:last-child {
			font-family: "Inter", sans-serif;
			font-weight: 700;
			font-style: normal;
			line-height: 1;
			font-size: 1rem;
		}

		p {
            padding: 0 0.75rem;
		}
	}

    .desktop.item {
		@media(max-width: 1024px) {
			display: none;
		}
    }
</style>

<script>
	const button = document.getElementById("menu-button")!;
	const closeIcon = document.getElementById("close-menu")!;
	const openIcon = document.getElementById("open-menu")!;
	const drawer = document.getElementById("drawer")!;

	let isMenuOpen = false;

	const setMenuOpen = (isOpen: boolean) => {
		if (isOpen) {
			closeIcon.style.opacity = "1.0";
			closeIcon.style.scale = "1.0";
			openIcon.style.opacity = "0.0";
			openIcon.style.scale = "0.0";
			openIcon.style.left = "0.0";
			drawer.style.maxHeight = drawer.style.height = "calc(100vh - var(--nav-height))";
		}
		else {
			closeIcon.style.opacity = "0.0";
			closeIcon.style.scale = "0.0";
			closeIcon.style.left = "0.0";
			openIcon.style.opacity = "1.0";
			openIcon.style.scale = "1.0";
			drawer.style.maxHeight = drawer.style.height = "0";
		}

		isMenuOpen = isOpen;
	}

	setMenuOpen(false);

	button.addEventListener('click', () => setMenuOpen(!isMenuOpen));
</script>
